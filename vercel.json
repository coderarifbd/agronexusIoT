{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/update(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/channels/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/channel/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/data(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
